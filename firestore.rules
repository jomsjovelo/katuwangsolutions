rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getTenantData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function isMasterAdmin() {
      // Security: Verify user exists in the admins collection
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasTenantAccess(tenantId) {
      let tenant = getTenantData(tenantId);
      return isAuthenticated() && (
        request.auth.uid == tenant.ownerUid || 
        request.auth.uid in tenant.get('staffUids', []) ||
        isMasterAdmin()
      );
    }

    // --- COLLECTION RULES ---

    // 0. Admins Collection
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isMasterAdmin();
    }

    // 1. Tenants Collection (The Isolation Shield)
    match /tenants/{tenantId} {
      // Allow users to read their own tenant metadata
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerUid || 
        request.auth.uid in resource.data.get('staffUids', []) ||
        isMasterAdmin()
      );
      
      // Allow users to create their own tenant document
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerUid;
      
      // Only the owner or Master Admin can update the tenant configuration
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerUid || 
        isMasterAdmin()
      );

      // 2. Sub-collections (Universal Inventory, Sales, etc.)
      match /{allSubcollections=**} {
        // Strict isolation: Access granted only to verified tenant owners/staff
        allow read, write: if hasTenantAccess(tenantId);
      }
      
      // 2.5 Allow Public RSVP Creation
      match /events/{eventId}/guests/{guestId} {
        // Allow anyone to create a guest entry for RSVPs
        allow create: if true;
      }
    }

    // 3. System Collection (Internal usage, only Master Admin)
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isMasterAdmin();
    }

    // 5. Users Collection (Staff profiles and owner profiles)
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && 
        resource.data.tenantId != null &&
        hasTenantAccess(resource.data.tenantId);
    }

    // 6. Invites Collection (Staff invitation flow)
    match /invites/{inviteId} {
      allow read, write: if isAuthenticated() && 
        hasTenantAccess(request.resource.data.tenantId);
      allow read, delete: if isAuthenticated() && 
        hasTenantAccess(resource.data.tenantId);
      allow read: if isAuthenticated();
    }

    // 7. True Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
