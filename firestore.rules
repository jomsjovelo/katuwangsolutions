rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getTenantData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    function hasMasterAdminClaim() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'superadmin' ||
        request.auth.token.get('isMasterAdmin', false) == true ||
        request.auth.token.get('adminRole', '') == 'superadmin'
      );
    }

    function hasValidAdminDocument() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'superadmin') in [
          'superadmin', 'admin', 'billing', 'support', 'auditor'
        ];
    }

    function isMasterAdmin() {
      // Signed server-issued claims and authoritative administrator documents
      // intentionally follow the same contract as the Command Center UI.
      return hasMasterAdminClaim() || hasValidAdminDocument();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'superadmin' ||
        request.auth.token.get('isMasterAdmin', false) == true ||
        request.auth.token.get('adminRole', '') == 'superadmin' ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'superadmin') == 'superadmin'
        )
      );
    }

    function isTenantOwner(tenantId) {
      return isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && request.auth.uid == getTenantData(tenantId).ownerUid;
    }

    /**
     * Explicit 6-Point Cashier Authorization Validator:
     * 1. Authenticated
     * 2. Custom claim role == 'cashier'
     * 3. Custom claim tenantId == tenantId
     * 4. Custom claim staffAccountId is non-empty
     * 5. auth.uid matches stored deterministic authUid on the active staff record
     * 6. Staff status is strictly 'active' and token sessionVersion matches stored sessionVersion
     */
    function isTenantCashier(tenantId) {
      let staffAccountId = request.auth.token.get('staffAccountId', '');
      let staffDoc = get(/databases/$(database)/documents/tenants/$(tenantId)/staff_accounts/$(staffAccountId));
      return isAuthenticated() &&
        request.auth.token.get('role', '') == 'cashier' &&
        request.auth.token.get('tenantId', '') == tenantId &&
        staffAccountId != '' &&
        request.auth.uid == staffDoc.data.get('authUid', '') &&
        staffDoc.data.get('status', '') == 'active' &&
        staffDoc.data.get('sessionVersion', 0) == request.auth.token.get('sessionVersion', -1);
    }

    function cashierActorId() {
      return 'staff_' + request.auth.token.get('staffAccountId', '');
    }

    /**
     * Universal Tenant Access (Owner, Staff with Firebase Auth, Super/Master Admins).
     * NOTE: Cashier is strictly EXCLUDED from universal tenant access.
     */
    function hasTenantAccess(tenantId) {
      let tenant = getTenantData(tenantId);
      return isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        request.auth.uid == tenant.ownerUid || 
        request.auth.uid in tenant.get('staffUids', []) ||
        isMasterAdmin()
      );
    }

    // --- COLLECTION RULES ---

    // 0. Admins Collection
    match /admins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isMasterAdmin();
      allow write: if isSuperAdmin();
    }

    // 1. Tenants Collection (The Isolation Shield)
    match /tenants/{tenantId} {
      allow get: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
      allow list: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.get('staffUids', []) ||
        isMasterAdmin()
      );
      
      allow create: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && request.auth.uid == request.resource.data.ownerUid;
      
      allow update: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        request.auth.uid == resource.data.ownerUid || 
        isMasterAdmin()
      ) && (
        isMasterAdmin() ||
        (!('businessCode' in resource.data) || request.resource.data.businessCode == resource.data.businessCode)
      ) && (
        isMasterAdmin() ||
        (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == resource.data.ownerUid)
      );

      allow delete: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        request.auth.uid == resource.data.ownerUid || 
        isSuperAdmin()
      );

      // --- SUB-COLLECTION RULES ---

      // 2. Staff Accounts Subcollection (Owner/Admin Only - Cashier Strictly Denied)
      match /staff_accounts/{staffId} {
        allow get, list, create, update, delete: if isTenantOwner(tenantId) || isMasterAdmin();
      }

      // 3. Products Subcollection (Owner/Admin/non-Cashier only; Secure Cashier uses server APIs)
      match /products/{productId} {
        allow get, list, create, update, delete: if hasTenantAccess(tenantId);
      }

      // 4. Sales Subcollection (Secure Cashier uses trusted checkout/receipt APIs)
      match /sales/{saleId} {
        allow get, list, create, update, delete: if hasTenantAccess(tenantId);
      }

      // 5. Inventory Transactions (Secure Cashier uses trusted checkout APIs)
      match /inventory_transactions/{txId} {
        allow get, list, create, update, delete: if hasTenantAccess(tenantId);
      }

      // 6. Shifts (Secure Cashier uses trusted shift/receipt APIs)
      match /shifts/{shiftId} {
        allow get, list, create, update, delete: if hasTenantAccess(tenantId);
      }

      // 7. Transactions (Financial ledger writes require a trusted server operation.)
      match /transactions/{txId} {
        allow get, list: if hasTenantAccess(tenantId);
        allow create, update: if hasTenantAccess(tenantId);
        allow delete: if hasTenantAccess(tenantId);
      }

      // 8. Retail Credits (Financial writes require a trusted server operation.)
      match /retail_credits/{creditId} {
        allow get, list: if hasTenantAccess(tenantId);
        allow create, update: if hasTenantAccess(tenantId);
        allow delete: if hasTenantAccess(tenantId);
      }

      // 9. Accounts (Owner/Admin/non-Cashier only; Secure Cashier has no master-cash access.)
      match /accounts/{accountId} {
        allow get, list, create, update, delete: if hasTenantAccess(tenantId);
      }

      // 10. Audit Log (immutable; Secure Cashier writes only through trusted server APIs)
      match /audit_log/{logId} {
        allow create: if hasTenantAccess(tenantId);
        allow read: if hasTenantAccess(tenantId);
        allow update, delete: if false; // Immutable audit trail
      }

      // 11. Offline Authorization Grants (Strictly Server-Only; Browser direct access denied)
      match /offline_grants/{grantId} {
        allow read, write: if false;
      }

      // 12. Offline Claims & Owner Resolutions (Strictly Server-Only; Browser direct access denied)
      match /offline_claims/{claimId} {
        allow read, write: if false;
      }
      match /claim_resolutions/{resolutionId} {
        allow read, write: if false;
      }

      // 13. Shift Close Idempotency (Strictly Server-Only; Browser direct access denied)
      match /shift_close_idempotency/{key} {
        allow read, write: if false;
      }

      // 14. Catalog Snapshots (Strictly Server-Only; Browser direct access denied)
      match /catalog_snapshots/{snapshotId} {
        allow read, write: if false;
      }

      // Tsek-In operational records are readable by authorized tenant users,
      // but all mutations must pass through the authenticated server services.
      match /rooms/{roomId} {
        allow get, list: if hasTenantAccess(tenantId);
        allow create, update, delete: if false;
      }
      match /bookings/{bookingId} {
        allow get, list: if hasTenantAccess(tenantId);
        allow create, update, delete: if false;
      }
      match /tsek_in_checkin_idempotency/{key} {
        allow read, write: if false;
      }
      match /tsek_in_checkout_idempotency/{key} {
        allow read, write: if false;
      }
      match /tsek_in_extension_idempotency/{key} {
        allow read, write: if false;
      }
      match /tsek_in_admin_idempotency/{key} {
        allow read, write: if false;
      }

      // 15. Cashier Sale Intents (B-Hybrid Firestore-Native Queue)
      match /cashier_sale_intents/{intentId} {
        // Read: Owner/admin, or the Cashier who created it
        allow get, list: if isMasterAdmin() || isTenantOwner(tenantId) || (
          isTenantCashier(tenantId) &&
          resource.data.authUid == request.auth.uid &&
          resource.data.staffAccountId == request.auth.token.get('staffAccountId', '')
        );

        // Create: Strictly Cashier creating their own valid pending cash intent
        allow create: if isTenantCashier(tenantId) &&
          request.resource.data.intentId == intentId &&
          request.resource.data.tenantId == tenantId &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.staffAccountId == request.auth.token.get('staffAccountId', '') &&
          request.resource.data.status == 'pending' &&
          request.resource.data.tender == 'cash' &&
          (request.resource.data.schemaVersion == 1 || request.resource.data.schemaVersion == 2) &&
          request.resource.data.items.size() > 0 &&
          request.resource.data.items.size() <= 100 &&
          request.resource.data.cashTenderedCentavos >= 0 &&
          request.resource.data.keys().hasAll(['schemaVersion', 'intentId', 'tenantId', 'authUid', 'staffAccountId', 'shiftId', 'tender', 'items', 'status', 'cashTenderedCentavos']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'intentId', 'tenantId', 'authUid', 'staffAccountId', 'shiftId', 'tender', 'items', 'itemCount', 'observedTotalCentavos', 'cashTenderedCentavos', 'changeRequiredCentavos', 'clientCreatedAt', 'status', 'offlineAuthorityDigest', 'clientSyncMetadata', 'cashierDisplayName']) &&
          !('finalization' in request.resource.data) &&
          !('authoritativeSaleId' in request.resource.data);

        // Updates & Deletions: Strictly denied for clients; server Admin SDK only
        allow update, delete: if false;
      }

      // 16. Public RSVP Creation
      match /events/{eventId}/guests/{guestId} {
        allow create: if request.resource.data.keys().size() <= 15;
      }

      // 17. Catch-all Tenant Subcollections (Strict isolation: Owner/Staff only, Cashier Denied)
      match /{subcollection}/{document=**} {
        allow read, create, update: if hasTenantAccess(tenantId);
        allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == getTenantData(tenantId).ownerUid);
      }
    }

    // WebAuthn Credentials (Strictly Server-Only; Browser direct read/write/list/delete denied)
    match /webauthn_credentials/{credentialIdHash} {
      allow read, write: if false;
    }

    // 13. System Collection (Publicly readable for maintenance mode & pricing configs)
    match /system/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 14. Users Collection (Owner and Staff Profiles - Cashier Strictly Denied)
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && request.auth.uid == userId;
      
      allow update: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        request.auth.uid == userId || isMasterAdmin() ||
        request.auth.uid == resource.data.enterpriseOwnerUid
      ) && (
        isMasterAdmin() ||
        !('businessCode' in resource.data) ||
        !('businessCode' in request.resource.data) ||
        request.resource.data.businessCode == resource.data.businessCode
      );

      allow delete: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (request.auth.uid == userId || isMasterAdmin());
      
      allow get: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && (
        isMasterAdmin() ||
        request.auth.uid == userId ||
        (resource != null && 'tenantId' in resource.data && resource.data.tenantId != null && resource.data.tenantId != '' && hasTenantAccess(resource.data.tenantId)) ||
        (resource != null && 'enterpriseOwnerUid' in resource.data && request.auth.uid == resource.data.enterpriseOwnerUid)
      );
      
      allow list: if isMasterAdmin() || (
        isAuthenticated() && request.auth.token.get('role', '') != 'cashier' &&
        (
          resource.data.enterpriseOwnerUid == request.auth.uid ||
          resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId
        )
      );
    }

    // 15. User Referral History
    match /users/{userId}/referral_history/{historyId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isMasterAdmin();
    }

    // 16. Invites Collection (Staff invitation flow)
    match /invites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email || 
        hasTenantAccess(resource.data.tenantId)
      );
      allow create, update: if isAuthenticated() && 
        hasTenantAccess(request.resource.data.tenantId);
      allow delete: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        hasTenantAccess(resource.data.tenantId)
      );
    }

    // 17. Global Announcements
    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 18. Billing Logs
    match /billing_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }
    
    // 19. Admin Audit Logs (Immutable)
    match /admin_logs/{logId} {
      allow read: if isMasterAdmin();
      allow create: if isMasterAdmin();
      allow update, delete: if false;
    }

    // 20. Support Tickets Collection Group
    match /{path=**}/support_tickets/{ticketId} {
      allow read, write: if isMasterAdmin();
    }
    
    // 21. Business Codes (server-resolved for Cashier login; no public read)
    match /business_codes/{codeId} {
      allow get: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
      allow list: if isMasterAdmin();
      allow write: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
    }
    
    // 22. Referral Codes (Public read for validation; non-cashier authenticated write)
    match /referral_codes/{codeId} {
      allow get: if true;
      allow list: if isMasterAdmin();
      allow write: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
    }
    
    // 23. Referral Withdrawals
    match /referral_withdrawals/{withdrawalId} {
      allow read, update: if isMasterAdmin();
      allow create: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier' && request.resource.data.uid == request.auth.uid;
    }
    
    // 24. System Expenses
    match /system_expenses/{expenseId} {
      allow read, write: if isMasterAdmin();
    }

    // 25. Mail Collection (Firebase Trigger Email)
    match /mail/{mailId} {
      allow create: if isMasterAdmin();
    }

    // 26. Staff Usernames (server-managed for Cashier lifecycle; no public read)
    match /staff_usernames/{username} {
      allow get: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
      allow list: if isMasterAdmin();
      allow create, delete: if isAuthenticated() && request.auth.token.get('role', '') != 'cashier';
    }

    // 27. True Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
